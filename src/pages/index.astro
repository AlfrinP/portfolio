---
import Layout from "@/layouts/main.astro"
import { siteData } from "@/data/data"

const notebookPublishedAt = new Intl.DateTimeFormat("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date("2026-08-10T00:00:00Z"))
---

<Layout
  title={`${siteData.profile.name} — ${siteData.profile.titleSuffix}`}
  activeTab="home"
>
  <main
    id="main-content"
    class="mx-auto w-full max-w-3xl px-5 pt-14 pb-28 sm:px-8 sm:pt-20 xl:pb-16"
  >
    <section
      id="intro"
      aria-labelledby="intro-title"
      class="scroll-mt-10 pb-12 sm:pb-16"
    >
      <div class="mb-6 flex items-center gap-4">
        <div
          class="grid size-14 shrink-0 place-items-center border border-border bg-card text-sm font-semibold text-primary"
          aria-hidden="true"
        >
          AP
        </div>
        <div>
          <p
            class="mb-1 text-[10px] tracking-[0.2em] text-muted-foreground uppercase"
          >
            {siteData.profile.role}
          </p>
          <h1
            id="intro-title"
            class="text-2xl font-semibold tracking-tight text-pretty sm:text-3xl"
          >
            {siteData.profile.name}
          </h1>
        </div>
      </div>
      <p
        class="max-w-2xl text-sm leading-7 text-muted-foreground sm:text-[15px] sm:leading-8"
      >
        {siteData.profile.bio}
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          href="#notebook"
          class="inline-flex min-h-11 items-center justify-center gap-2 bg-primary px-4 text-xs font-medium text-primary-foreground transition-colors hover:opacity-90"
        >
          Read the notebook <span aria-hidden="true">↓</span>
        </a>
        <a
          href="#projects"
          class="inline-flex min-h-11 items-center justify-center border border-border px-4 text-xs text-foreground transition-colors hover:bg-muted"
          >Explore projects</a
        >
      </div>
    </section>

    <section
      id="about"
      aria-labelledby="about-title"
      class="scroll-mt-8 border-t border-border py-9 sm:py-11"
    >
      <p class="mb-2 text-[10px] tracking-[0.18em] text-primary uppercase">
        01 / Approach
      </p>
      <h2 id="about-title" class="mb-4 text-lg font-semibold sm:text-xl">
        About
      </h2>
      <p class="max-w-2xl text-sm leading-7 text-muted-foreground">
        {siteData.profile.about}
      </p>
      <div class="mt-5 flex flex-wrap gap-2">
        {
          siteData.profile.interests.map((interest) => (
            <span class="border border-border-subtle bg-card px-2.5 py-1.5 text-[10px] text-muted-foreground">
              {interest}
            </span>
          ))
        }
      </div>
    </section>

    <section
      id="notebook"
      aria-labelledby="notebook-title"
      class="scroll-mt-8 border-t border-border py-9 sm:py-11"
    >
      <div class="mb-2 text-[10px] tracking-[0.18em] text-primary uppercase">
        02 / Notes & investigations
      </div>
      <h2 id="notebook-title" class="text-lg font-semibold sm:text-xl">
        Notebook
      </h2>
      <p class="mt-2 text-xs leading-6 text-muted-foreground">
        Things I’ve learned, broken, built, and understood.
      </p>

      <a
        href="/notebook/how-databases-find-data"
        class="group mt-5 block border-y border-border py-5 transition-colors hover:border-primary"
      >
        <div
          class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-[10px] tracking-[0.12em] text-muted-foreground uppercase"
        >
          <span>{notebookPublishedAt}</span><span aria-hidden="true">·</span
          ><span>8 min read</span>
          <span class="border border-primary/40 px-2 py-1 text-primary"
            >Databases</span
          >
          <span class="ml-auto text-primary">Latest</span>
        </div>
        <h3
          class="max-w-2xl text-base leading-7 font-medium text-pretty text-foreground transition-colors group-hover:text-primary sm:text-lg"
        >
          How does a database actually find your data?
        </h3>
        <p class="mt-2 max-w-2xl text-xs leading-6 text-muted-foreground">
          An exploration of B-Trees, indexes, and how relational databases
          locate records among millions of rows.
        </p>
        <span
          class="mt-4 inline-flex min-h-11 items-center gap-2 text-[10px] tracking-wider text-muted-foreground uppercase group-hover:text-primary"
          >Read entry <span aria-hidden="true">↗</span></span
        >
      </a>
    </section>

    <section
      id="projects"
      aria-labelledby="projects-title"
      class="scroll-mt-8 border-t border-border py-9 sm:py-11"
    >
      <p class="mb-2 text-[10px] tracking-[0.18em] text-primary uppercase">
        03 / Selected work
      </p>
      <h2 id="projects-title" class="text-lg font-semibold sm:text-xl">
        Projects
      </h2>

      <article class="mt-5 border border-border bg-card">
        <div
          class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-3 text-[10px] tracking-[0.12em] text-muted-foreground uppercase sm:px-5"
        >
          <span>Featured project · AI systems</span><span>01</span>
        </div>
        <div class="p-4 sm:p-5">
          <h3 class="text-base leading-7 font-semibold text-pretty sm:text-lg">
            A high-performance LLM inference engine
          </h3>
          <p class="mt-3 max-w-2xl text-xs leading-6 text-muted-foreground">
            A C++ and CUDA inference engine focused on memory bandwidth and
            low-latency local model deployment.
          </p>
          <div class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
            {
              ["C++", "CUDA", "PyTorch", "SIMD", "KV cache"].map(
                (technology) => (
                  <span class="border border-border px-2.5 py-1.5 text-[10px] text-muted-foreground">
                    {technology}
                  </span>
                )
              )
            }
          </div>
          <a
            href="/projects/llm-inference-engine"
            class="mt-4 inline-flex min-h-11 items-center gap-2 text-[11px] tracking-wider text-primary uppercase hover:underline"
          >
            Explore project <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </section>

    <section
      id="socials"
      aria-labelledby="socials-title"
      class="scroll-mt-8 border-t border-border py-9 sm:py-11"
    >
      <p class="mb-2 text- tracking-[0.18em] text-primary uppercase">
        04 / Around the web
      </p>
      <h2 id="socials-title" class="text-lg font-semibold sm:text-xl">
        Socials & contact
      </h2>
      <p class="mt-2 max-w-xl text-xs leading-6 text-muted-foreground">
        For engineering conversations, ideas, or collaboration, you can find me
        here.
      </p>
      <div class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {
          siteData.links.github && (
            <a
              href={siteData.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="flex min-h-12 items-center justify-between border border-border bg-card px-4 text-xs text-foreground transition-colors hover:border-primary hover:text-primary"
            >
              <>
                <span>GitHub</span>
                <span aria-hidden="true">↗</span>
              </>
            </a>
          )
        }
        {
          siteData.links.linkedin && (
            <a
              href={siteData.links.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="flex min-h-12 items-center justify-between border border-border bg-card px-4 text-xs text-foreground transition-colors hover:border-primary hover:text-primary"
            >
              <>
                <span>LinkedIn</span>
                <span aria-hidden="true">↗</span>
              </>
            </a>
          )
        }
        {
          siteData.links.email && (
            <a
              href={`mailto:${siteData.links.email}`}
              class="flex min-h-12 min-w-0 items-center justify-between gap-3 border border-border bg-card px-4 text-xs text-foreground transition-colors hover:border-primary hover:text-primary"
            >
              <>
                <span class="min-w-0 break-all">Email</span>
                <span aria-hidden="true">↗</span>
              </>
            </a>
          )
        }
        {
          siteData.links.resume && (
            <a
              href={siteData.links.resume}
              target="_blank"
              rel="noopener noreferrer"
              class="flex min-h-12 items-center justify-between border border-border bg-card px-4 text-xs text-foreground transition-colors hover:border-primary hover:text-primary"
            >
              <>
                <span>Resume</span>
                <span aria-hidden="true">↗</span>
              </>
            </a>
          )
        }
      </div>
    </section>
  </main>
</Layout>
