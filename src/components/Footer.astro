---
import { siteData } from "@/data/data"
---

<footer class="w-full py-12 mt-24 bg-[#0A0A0A] border-t border-[#414755]/50">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 px-6 md:px-8 max-w-[1440px] mx-auto">
    <div>
      <span class="font-['JetBrains_Mono'] text-xs uppercase tracking-widest text-[#8b90a0] block mb-4">
        {siteData.profile.name}
      </span>
      <p class="font-['Geist'] text-xs text-[#c1c6d7] leading-relaxed">
        © {siteData.footer.copyrightYear} {siteData.profile.name}. {siteData.footer.tagline}
      </p>
    </div>

    <div class="flex flex-col gap-2 font-['JetBrains_Mono'] text-xs">
      <span class="text-[#e0e2ed] uppercase tracking-wider mb-2 font-bold">RESOURCES</span>
      <a href="/#notebook" class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors">Documentation</a>
      <a href="/#projects" class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors">Changelog</a>
    </div>

    <div class="flex flex-col gap-2 font-['JetBrains_Mono'] text-xs">
      <span class="text-[#e0e2ed] uppercase tracking-wider mb-2 font-bold">NAVIGATION</span>
      <a href="/" class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors">Home</a>
      <a href="/projects/llm-inference-engine" class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors">LLM Inference Engine</a>
      <a href="/notebook/how-databases-find-data" class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors">Database Indexing Article</a>
    </div>

    <div class="flex flex-col gap-2 font-['JetBrains_Mono'] text-xs">
      <span class="text-[#e0e2ed] uppercase tracking-wider mb-2 font-bold">CONNECT</span>
      {siteData.links.github && <a href={siteData.links.github} target="_blank" rel="noopener noreferrer" class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors flex items-center gap-2">
        <span class="material-symbols-outlined text-[16px]">code</span> GitHub
      </a>}
      {siteData.links.linkedin && <a href={siteData.links.linkedin} target="_blank" rel="noopener noreferrer" class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors flex items-center gap-2">
        <span class="material-symbols-outlined text-[16px]">group</span> LinkedIn
      </a>}
      {siteData.links.resume && <a href={siteData.links.resume} target="_blank" rel="noopener noreferrer" class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors flex items-center gap-2">
        <span class="material-symbols-outlined text-[16px]">description</span> Resume
      </a>}
      {siteData.links.email && <a href={`mailto:${siteData.links.email}`} class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors flex items-center gap-2">
        <span class="material-symbols-outlined text-[16px]">alternate_email</span> Email
      </a>}
    </div>
  </div>
</footer>
