---
interface Props {
  activeTab?: 'home' | 'notebook' | 'projects' | 'about';
}

import { AtSign, BookOpen, Grid2X2, House, Moon, Sun, UserRound } from 'lucide-react';

const { activeTab = 'home' } = Astro.props;
const sections = [
  { label: 'Intro', short: 'Home', id: 'intro', icon: House },
  { label: 'About', short: 'About', id: 'about', icon: UserRound },
  { label: 'Notebook', short: 'Notes', id: 'notebook', icon: BookOpen },
  { label: 'Projects', short: 'Work', id: 'projects', icon: Grid2X2 },
  { label: 'Socials', short: 'Social', id: 'socials', icon: AtSign },
];
const currentSection = activeTab === 'home' ? 'intro' : activeTab;
---

<a href="#main-content" class="sr-only fixed left-4 top-4 z-70 bg-background px-4 py-3 text-sm text-foreground focus:not-sr-only focus-visible:ring-2 focus-visible:ring-ring">Skip to content</a>

<aside aria-label="Section navigation" class="fixed right-40 top-1/2 z-50 hidden -translate-y-1/2 xl:block">
  <nav aria-label="Page sections" class="flex flex-col items-start border-l border-border pl-4">
    <span class="mb-3 text-[9px] uppercase tracking-[0.18em] text-muted-foreground">Contents</span>
    {sections.map(({ label, id }) => (
      <a href={`/#${id}`} data-section-link={id} aria-current={currentSection === id ? 'location' : undefined} class:list={[
        'flex min-h-10 items-center border-l-2 border-transparent pl-3 text-[10px] uppercase tracking-wider transition-colors hover:text-primary',
        currentSection === id ? 'border-primary text-primary' : 'text-muted-foreground',
      ]}>{label}</a>
    ))}
    <button data-theme-toggle type="button" class="mt-3 grid size-10 place-items-center border-t border-border text-muted-foreground transition-colors hover:text-primary" aria-label="Switch to light theme" title="Toggle theme">
      <Sun class="hidden size-5 dark:block" aria-hidden="true" />
      <Moon class="size-5 dark:hidden" aria-hidden="true" />
    </button>
  </nav>
</aside>

<nav aria-label="Mobile section navigation" class="fixed inset-x-0 bottom-0 z-50 touch-manipulation px-3 pb-[env(safe-area-inset-bottom)] xl:hidden">
  <div class="mx-auto mb-3 flex max-w-lg items-stretch justify-around border border-border bg-card/95 px-1 shadow-xl backdrop-blur">
    {sections.map(({ short, id, icon: Icon }) => (
      <a href={`/#${id}`} data-section-link={id} aria-current={currentSection === id ? 'location' : undefined} aria-label={short} class:list={[
        'flex min-h-14 min-w-0 flex-1 flex-col items-center justify-center gap-1 border-t-2 border-transparent px-1 text-[9px] uppercase tracking-wide transition-colors',
        currentSection === id ? 'border-primary text-primary' : 'text-muted-foreground hover:text-foreground',
      ]}>
        <Icon class="size-[18px]" strokeWidth={1.8} aria-hidden="true" />
        <span>{short}</span>
      </a>
    ))}
    <button data-theme-toggle type="button" class="flex min-h-14 min-w-0 flex-1 flex-col items-center justify-center gap-1 px-1 text-muted-foreground transition-colors hover:text-primary" aria-label="Switch theme" title="Toggle theme">
      <Sun class="hidden size-[18px] dark:block" aria-hidden="true" />
      <Moon class="size-[18px] dark:hidden" aria-hidden="true" />
      <span class="text-[9px] uppercase tracking-wide">Theme</span>
    </button>
  </div>
</nav>

<script>
  const themeToggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const sectionLinks = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
  const sectionIds = ['intro', 'about', 'notebook', 'projects', 'socials'];

  function syncThemeControls() {
    const darkTheme = document.documentElement.classList.contains('dark');
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', darkTheme ? '#09090b' : '#f7f7f5');
    themeToggles.forEach((button) => {
      button.setAttribute('aria-label', darkTheme ? 'Switch to light theme' : 'Switch to dark theme');
    });
  }

  themeToggles.forEach((button) => {
    button.addEventListener('click', () => {
      const darkTheme = document.documentElement.classList.toggle('dark');
      localStorage.setItem('portfolio-theme', darkTheme ? 'dark' : 'light');
      syncThemeControls();
    });
  });

  function setActiveSection(sectionId: string) {
    sectionLinks.forEach((link) => {
      const isActive = link.dataset.sectionLink === sectionId;
      if (isActive) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  }

  syncThemeControls();
  const observedSections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((section): section is HTMLElement => section instanceof HTMLElement);

  if (observedSections.length) {
    let scrollFrame = 0;

    const updateActiveSection = () => {
      scrollFrame = 0;
      const activationLine = window.innerHeight * 0.35;
      let activeId = observedSections[0].id;

      for (const section of observedSections) {
        if (section.getBoundingClientRect().top <= activationLine) activeId = section.id;
        else break;
      }

      setActiveSection(activeId);
    };

    const scheduleSectionUpdate = () => {
      if (!scrollFrame) scrollFrame = window.requestAnimationFrame(updateActiveSection);
    };

    window.addEventListener('scroll', scheduleSectionUpdate, { passive: true });
    window.addEventListener('resize', scheduleSectionUpdate);
    updateActiveSection();
  }
</script>
