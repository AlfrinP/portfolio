---
interface Props {
  activeTab?: 'home' | 'notebook' | 'projects' | 'about';
}

const { activeTab = 'home' } = Astro.props;
---

<nav class="w-full sticky top-0 z-50 bg-[#10131b]/90 backdrop-blur-sm border-b border-[#414755]/50 transition-colors duration-200">
  <div class="flex justify-between items-center px-6 md:px-8 py-4 max-w-[1440px] mx-auto">
    <a href="/" class="font-['Geist'] text-2xl font-bold text-[#e0e2ed] hover:text-[#adc6ff] transition-colors">
      Alfrin
    </a>

    <div class="hidden md:flex gap-8 items-center font-['JetBrains_Mono'] text-xs uppercase tracking-wider">
      <a 
        href="/#notebook" 
        class={`transition-colors py-1 ${activeTab === 'notebook' ? 'text-[#adc6ff] border-b border-[#adc6ff]' : 'text-[#c1c6d7] hover:text-[#adc6ff]'}`}
      >
        Notebook
      </a>
      <a 
        href="/#projects" 
        class={`transition-colors py-1 ${activeTab === 'projects' ? 'text-[#adc6ff] border-b border-[#adc6ff]' : 'text-[#c1c6d7] hover:text-[#adc6ff]'}`}
      >
        Projects
      </a>
      <a 
        href="/#about" 
        class={`transition-colors py-1 ${activeTab === 'about' ? 'text-[#adc6ff] border-b border-[#adc6ff]' : 'text-[#c1c6d7] hover:text-[#adc6ff]'}`}
      >
        About
      </a>
    </div>

    <div class="flex items-center gap-4">
      <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors p-1" title="GitHub">
        <span class="material-symbols-outlined text-[20px]">code</span>
      </a>
      <a href="mailto:contact@alfrin.dev" class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors p-1" title="Contact">
        <span class="material-symbols-outlined text-[20px]">alternate_email</span>
      </a>
      <a href="/rss.xml" class="text-[#c1c6d7] hover:text-[#adc6ff] transition-colors p-1" title="RSS Feed">
        <span class="material-symbols-outlined text-[20px]">rss_feed</span>
      </a>

      <!-- Mobile Menu Toggle Button -->
      <button 
        id="mobile-menu-btn" 
        class="md:hidden text-[#c1c6d7] hover:text-[#e0e2ed] p-1 focus:outline-none"
        aria-label="Toggle navigation menu"
      >
        <span class="material-symbols-outlined text-[24px]">menu</span>
      </button>
    </div>
  </div>
</nav>

<!-- Mobile Navigation Drawer -->
<div 
  id="mobile-drawer" 
  class="fixed inset-y-0 left-0 w-64 z-50 bg-[#1c2028] border-r border-[#414755] transform -translate-x-full transition-transform duration-300 ease-in-out md:hidden flex flex-col p-6 shadow-2xl"
>
  <div class="flex justify-between items-center mb-8 border-b border-[#262626] pb-4">
    <div>
      <h2 class="font-['Geist'] text-xl font-bold text-[#e0e2ed]">Alfrin</h2>
      <p class="font-['Geist'] text-xs text-[#c1c6d7] mt-0.5">Engineering Notebook</p>
    </div>
    <button id="close-drawer-btn" class="text-[#c1c6d7] hover:text-[#e0e2ed]">
      <span class="material-symbols-outlined">close</span>
    </button>
  </div>

  <nav class="flex flex-col gap-3 font-['JetBrains_Mono'] text-xs uppercase tracking-wider">
    <a href="/" class="flex items-center gap-3 p-3 bg-[#3131c0] text-[#e0e2ed] rounded-lg">
      <span class="material-symbols-outlined text-[18px]">home</span>
      <span>Home</span>
    </a>
    <a href="/#notebook" class="flex items-center gap-3 p-3 text-[#c1c6d7] hover:bg-[#31353d] rounded-lg transition-colors">
      <span class="material-symbols-outlined text-[18px]">menu_book</span>
      <span>Notebook</span>
    </a>
    <a href="/#projects" class="flex items-center gap-3 p-3 text-[#c1c6d7] hover:bg-[#31353d] rounded-lg transition-colors">
      <span class="material-symbols-outlined text-[18px]">terminal</span>
      <span>Projects</span>
    </a>
    <a href="/#about" class="flex items-center gap-3 p-3 text-[#c1c6d7] hover:bg-[#31353d] rounded-lg transition-colors">
      <span class="material-symbols-outlined text-[18px]">person</span>
      <span>About</span>
    </a>
  </nav>
</div>

<!-- Drawer Backdrop -->
<div id="drawer-backdrop" class="fixed inset-0 bg-black/60 z-40 hidden md:hidden"></div>

<script>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('close-drawer-btn');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('drawer-backdrop');

  function openDrawer() {
    drawer?.classList.remove('-translate-x-full');
    backdrop?.classList.remove('hidden');
  }

  function closeDrawer() {
    drawer?.classList.add('-translate-x-full');
    backdrop?.classList.add('hidden');
  }

  menuBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  backdrop?.addEventListener('click', closeDrawer);
</script>
